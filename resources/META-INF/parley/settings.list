# The settings parley-files reads, for the start-up check of parley-net's servers
# (format: parley-net's KnownSettings). Add a name here when code here starts reading it.

parley.files.defaultFactory
parley.files.lockDirectory
parley.credentials.cmd.enabled
parley.credentials.cmd.timeout
parley.credentials.keyStore
# one caller's own value: parley.credentials.ID.NAME, the id one or two segments (sftp, acl.jdbc)
parley.credentials.*.cmd.{enabled,timeout}
parley.credentials.*.*.cmd.{enabled,timeout}
parley.credentials.*.keyStore
parley.credentials.*.*.keyStore
parley.files.windows.groupSid
parley.files.windows.otherSid
